# ============================================================
#  芙洛理 Flori · 服务端 .gitignore
#  零第三方依赖（无 node_modules）。重点：绝不提交任何密钥与运行时数据。
# ============================================================

# ---- 运行时数据（含 secret.key / 用户数据 / 媒体 / 房间聊天）----
data/

# ---- 冒烟测试夹具（含 secret.key 副本与测试账户），不入库 ----
.smoke/
.smoke2/

# ---- 显式兜底：任何位置的密钥文件 ----
secret.key
*.key

# ---- 日志 ----
*.log

# ---- 依赖（当前零依赖，留作防护）----
node_modules/

# ---- 发布包（release.js 静态下发目录，按需生成）----
releases/

# ---- 编辑器 / 系统 ----
.vs/
*.swp
.DS_Store
